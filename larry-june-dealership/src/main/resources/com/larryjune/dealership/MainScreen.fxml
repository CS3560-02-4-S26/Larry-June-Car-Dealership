<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="633.0" prefWidth="959.0" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <!-- Header -->
        <HBox prefHeight="111.0" maxWidth="1.7976931348623157E308" style="-fx-background-color: black;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <children>
                <ImageView fitHeight="80.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                </ImageView>

                <Label style="-fx-text-fill: white;" text="Larry June Car Dealership">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <children>
                        <Button mnemonicParsing="false"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"
                                text="Vehicles" />
                        <Button mnemonicParsing="false"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"
                                text="Information" />
                        <Button mnemonicParsing="false"
                                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                                text="Login" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Content -->
        <VBox alignment="TOP_CENTER" spacing="30" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <children>
                <Label text="Featured Vehicles" textAlignment="CENTER">
                    <font>
                        <Font name="Helvetica Bold" size="24.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="30" maxWidth="1.7976931348623157E308">
                    <children>
                        <!-- Card 1 -->
                        <VBox alignment="TOP_LEFT" minWidth="180.0" prefWidth="220.0" maxWidth="260.0"
                              prefHeight="260.0"
                              style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-padding: 15; -fx-spacing: 8;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@sienna.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #222222;" text="Toyota">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Msrp - $12,000" />
                                <Label text="Family vehicle Adventure ready" wrapText="true" />
                            </children>
                        </VBox>

                        <!-- Card 2 -->
                        <VBox alignment="TOP_LEFT" minWidth="180.0" prefWidth="220.0" maxWidth="260.0"
                              prefHeight="260.0"
                              style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-padding: 15; -fx-spacing: 8;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@civic.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #222222; -fx-font-weight: bold;" text="Civic Si">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Msrp - $30,000" />
                                <Label text="Sport car of a lifetime" wrapText="true" />
                            </children>
                        </VBox>

                        <!-- Card 3 -->
                        <VBox alignment="TOP_LEFT" minWidth="180.0" prefWidth="220.0" maxWidth="260.0"
                              prefHeight="260.0"
                              style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-padding: 15; -fx-spacing: 8;"
                              HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@chevy.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #222222;" text="Chevrolet Silverado">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Label text="Msrp - $60,000" />
                                <Label text="Road ready" wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
