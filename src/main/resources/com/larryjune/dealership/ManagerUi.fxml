<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="447.0" prefWidth="786.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.larryjune.dealership.Add">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" style="-fx-background-color: black;" spacing="15.0">
            <padding>
                <Insets top="0.0" right="20.0" bottom="0.0" left="20.0"/>
            </padding>

            <children>
                <ImageView fitHeight="80.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                </ImageView>

                <Label style="-fx-text-fill: white;" text="Larry June Car Dealership" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="passwordField"
                        mnemonicParsing="false"
                        prefHeight="31.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Vehicles"
                        textFill="#fffefe">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>

                <Button mnemonicParsing="false"
                        onAction="#goBack"
                        prefHeight="31.0"
                        style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-text-fill: white;"
                        text="Back" />

                <Button mnemonicParsing="false"
                        prefHeight="31.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="Login" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" alignment="TOP_LEFT">
            <padding>
                <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
            </padding>

            <children>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="vehicle"
                                mnemonicParsing="false"
                                onAction="#addVehicle"
                                style="-fx-background-color: black;"
                                text="+ Add Vehicle"
                                textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>

                        <Button fx:id="employee"
                                mnemonicParsing="false"
                                onAction="#addEmployee"
                                style="-fx-background-color: black;"
                                text="+ Add Employee"
                                textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <Label alignment="CENTER"
                       maxWidth="250.0"
                       prefHeight="35.0"
                       style="-fx-background-color: black; -fx-text-fill: white;"
                       text="Car Inventory"
                       textAlignment="CENTER"
                       textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <GridPane VBox.vgrow="ALWAYS" maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="16.66" hgrow="ALWAYS" />
                        <ColumnConstraints percentWidth="16.70" hgrow="ALWAYS" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints prefHeight="45.0" vgrow="NEVER" />
                        <RowConstraints vgrow="ALWAYS" />
                        <RowConstraints vgrow="ALWAYS" />
                        <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>

                    <children>
                        <Label alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: black;"
                               text="Photo"
                               textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <Label alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: black;"
                               text="Make &amp; Model"
                               textFill="WHITE"
                               GridPane.columnIndex="1">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <Label alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: black;"
                               text="Year"
                               textFill="WHITE"
                               GridPane.columnIndex="2">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <Label alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: black;"
                               text="License Plate"
                               textFill="WHITE"
                               GridPane.columnIndex="3">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <Label alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: black;"
                               text="Status"
                               textFill="WHITE"
                               GridPane.columnIndex="4">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>

                        <Label alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               maxHeight="1.7976931348623157E308"
                               style="-fx-background-color: black;"
                               text="Mileage"
                               textFill="WHITE"
                               GridPane.columnIndex="5">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                    </children>
                </GridPane>
            </children>
        </VBox>
    </center>
</BorderPane>
