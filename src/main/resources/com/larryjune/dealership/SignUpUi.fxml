<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.larryjune.dealership.InsertAccountController">

   <children>
      <VBox AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">

         <children>

            <HBox style="-fx-background-color: black;">
               <children>
                  <ImageView fitHeight="126.0"
                             fitWidth="163.0"
                             pickOnBounds="true"
                             preserveRatio="true">
                     <image>
                        <Image url="@logo.png" />
                     </image>
                  </ImageView>

                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Larry June Dealership"
                               style="-fx-font-size: 25; -fx-text-fill: white; -fx-font-weight: bold;">
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                        </Label>

                        <Label text="Where the Wheels Take You"
                               style="-fx-font-size: 12; -fx-text-fill: grey; -fx-font-weight: bold;">
                           <padding>
                              <Insets left="20.0" />
                           </padding>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
               </padding>

               <children>
                  <VBox maxWidth="400.0"
                        alignment="CENTER"
                        spacing="16.0"
                        fillWidth="true"
                        style="-fx-background-color: white;
                               -fx-background-radius: 14;
                               -fx-padding: 30;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 15, 0.2, 0, 4);">

                     <children>
                        <Label text="Sign Up"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: black;" />

                        <TextField fx:id="firstNameField"
                                   maxWidth="Infinity"
                                   promptText="First Name"
                                   style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <TextField fx:id="lastNameField"
                                   maxWidth="Infinity"
                                   promptText="Last Name"
                                   style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <TextField fx:id="emailField"
                                   maxWidth="Infinity"
                                   promptText="Email"
                                   style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <TextField fx:id="phoneField"
                                   maxWidth="Infinity"
                                   promptText="Phone Number (000-000-000)"
                                   style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <TextField fx:id="shippingAddressField"
                                   maxWidth="Infinity"
                                   promptText="Address"
                                   style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <PasswordField fx:id="passwordField"
                                       maxWidth="Infinity"
                                       promptText="Enter Password"
                                       style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <PasswordField fx:id="confirmPasswordField"
                                       maxWidth="Infinity"
                                       promptText="Confirm Password"
                                       style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: grey; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <Label fx:id="statusLabel"
                               text=""
                               style="-fx-text-fill: red; -fx-font-size: 12;" />

                        <HBox alignment="CENTER"
                              spacing="20.0">
                           <children>
                              <Button text="Back"
                                      mnemonicParsing="false"
                                      onAction="#handleBack"
                                      style="-fx-background-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #9a9a9a; -fx-text-fill: #333333; -fx-font-size: 13; -fx-padding: 10 20 10 20;" />

                              <Button text="Enter"
                                      mnemonicParsing="false"
                                      onAction="#handleSignUp"
                                      style="-fx-background-color: transparent; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #9a9a9a; -fx-text-fill: #333333; -fx-font-size: 13; -fx-padding: 10 20 10 20;" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>

         </children>
      </VBox>
   </children>
</AnchorPane>