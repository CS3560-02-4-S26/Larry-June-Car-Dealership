<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="575.0" prefWidth="890.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.larryjune.dealership.LoginScreenController">
   <children>
      <VBox prefHeight="400.0" prefWidth="600.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">
         <children>
            <HBox prefHeight="107.0" prefWidth="890.0"
                  style="-fx-background-color: linear-gradient(to right, #0f0f0f, #1c1c1c); -fx-padding: 20;"
                  VBox.vgrow="NEVER">
               <children>
                  <VBox prefHeight="50.0" prefWidth="528.0">
                     <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"
                               text="Larry June Dealership" />
                        <Label style="-fx-text-fill: grey; -fx-font-weight: bold;"
                               text="Where the Wheels Take You" />
                     </children>
                  </VBox>

                  <ImageView fitHeight="106.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@logo.png" />
                     </image>
                  </ImageView>
               </children>
            </HBox>

            <StackPane prefHeight="316.0" prefWidth="626.0"
                       style="-fx-background-color: linear-gradient(to bottom, #f4f4f4, #e8ebef);"
                       VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER"
                        maxHeight="300.0"
                        maxWidth="400.0"
                        prefHeight="200.0"
                        prefWidth="350.0"
                        spacing="16.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 15, 0.2, 0, 4); -fx-spacing: 16;"
                        StackPane.alignment="CENTER">
                     <children>
                        <Label prefHeight="34.0" prefWidth="168.0"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: black;"
                               text="Login" />
                              
                       <!--Username-->
                        <TextField fx:id = "usernameField"
                                    promptText="Username"
                                    
                                   style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: #d8d8d8; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />
                     <!--Password-->
                        <PasswordField fx:id = "passwordField"
                                 promptText="Password"
                                       style="-fx-background-color: #f8f8f8; -fx-background-radius: 8; -fx-border-color: #d8d8d8; -fx-border-radius: 8; -fx-padding: 10 12 10 12; -fx-font-size: 13;" />

                        <HBox spacing="20.0" alignment="CENTER">
                           <children>
                              <Button mnemonicParsing="false"
                                      style="-fx-background-color: transparent; -fx-border-color: #9a9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #333333; -fx-font-size: 13; -fx-padding: 10 20 10 20;"
                                      text="Back"
                                      onAction="#handleBack" />

                              <Button mnemonicParsing="false"
                                      style="-fx-background-color: transparent; -fx-border-color: #9a9a9a; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #333333; -fx-font-size: 13; -fx-padding: 10 20 10 20;"
                                      text="Login"
                                      onAction="#handleSubmitLogin" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </VBox>
   </children>
</AnchorPane>